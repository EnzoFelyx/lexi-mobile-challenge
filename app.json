{
  "expo": {
    "name": "Lexi",
    "slug": "Lexi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lexi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.enzo-felyx.Lexi",
      "appleTeamId": "8T52SZS49C",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": false
      }
    },
    "android": {
      "package": "com.enzofelyx.lexi",
      "adaptiveIcon": {
        "backgroundColor": "#F8F7F3",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F7F3",
          "image": "./assets/images/splash-wordmark.png",
          "imageWidth": 144,
          "dark": {
            "backgroundColor": "#111715",
            "image": "./assets/images/splash-wordmark-dark.png"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "3c15436a-8072-4964-b6de-6e20dfa2259d"
      }
    },
    "owner": "enzo_felyx"
  }
}
