# Copie para .env e preencha com os dados do seu projeto Supabase (botão Connect no painel).
# Só a publishable key: o RLS protege os dados. Nunca coloque a secret ou service_role key aqui.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
